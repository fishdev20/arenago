{
    "root": true,
    "extends": [
      "next/core-web-vitals",
      "eslint:recommended",
      "plugin:prettier/recommended"
    ],
    "plugins": ["prettier"],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "singleQuote": true,
          "semi": false,
          "tabWidth": 2,
          "trailingComma": "es5",
          "printWidth": 100
        }
      ]
    }
  }
